# Copier en .env et remplir. Ce fichier-là n'est jamais versionné.

# TMDB : « Jeton d'accès en lecture à l'API » (Paramètres → API).
TMDB_JETON=
# ou, à défaut, la clé d'API courte :
# TMDB_CLE=

# Trakt : « Client ID » d'une application créée sur trakt.tv/oauth/applications,
# et le nom du profil (public). Pour un profil privé, ajouter un jeton d'accès.
TRAKT_CLIENT_ID=
TRAKT_UTILISATEUR=
# TRAKT_JETON=

# Plex (facultatif) : adresse du serveur et jeton X-Plex-Token.
# PLEX_URL=http://192.168.1.x:32400
# PLEX_JETON=

# KINO_LANGUE=fr-FR
# KINO_BASE=kino.sqlite
